# ========================================================
# S CAR TRAVELS PREMIUM - Environment Configuration
# Kotananduru, Andhra Pradesh
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_EXPIRY=8h
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# --------------------------------------------------------
# SUPABASE CONFIGURATION (Phase 2)
# --------------------------------------------------------
# Find these in your Supabase Dashboard:
# 1. Project URL & Publishable Key:
#    Dashboard -> Project Settings (gear icon) -> API -> Project URL & Project API Keys (anon / public)
# 2. Service Role Key (SERVER ONLY):
#    Dashboard -> Project Settings -> API -> Project API Keys (service_role / secret)
#    WARNING: NEVER commit or expose the service_role key to browser / client code!

# Frontend Client Keys (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here

# Backend Server Keys (Express API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# --------------------------------------------------------
# LEGACY / LOCAL FALLBACK AUTHENTICATION
# --------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_in_production_min32chars
DATABASE_PATH=./server/data/scar_travels.db

# Initial Admin Credentials
ADMIN_INITIAL_USERNAME=srinu
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password_min8chars
# Optional emergency override for production: ADMIN_PASSWORD_OVERRIDE=your_new_strong_password

# Business Contact Details
OWNER_PHONE=9550641408
WHATSAPP_NUMBER=919550641408
BASE_LOCATION=Kotananduru, Andhra Pradesh

# --------------------------------------------------------
# EMAIL NOTIFICATIONS (RESEND - SERVER SIDE ONLY)
# --------------------------------------------------------
# Obtain your secret API key from https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_secret_key_here
# Email address where admin receives new customer booking alerts
ADMIN_NOTIFICATION_EMAIL=srinucartravelspremium@gmail.com
# Sender email (use verified domain in production, or onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=S CAR TRAVELS PREMIUM <onboarding@resend.dev>
